##############################################
# TensorStudio
##############################################

CLAUDE_CODE_USE_OPENAI=1

OPENAI_BASE_URL=https://api.tensorstudio.ai/v1
OPENAI_API_KEY=sk-your-key-here

# Prefer kimi3 for quality. Pair with wall-clock + speed budget to avoid hour runs.
#OPENAI_MODEL=qwen3-30b
OPENAI_MODEL=ox-alpha

CLAUDE_CODE_MAX_OUTPUT_TOKENS=8192
MAX_THINKING_TOKENS=0

##############################################
# gRPC
##############################################

GRPC_HOST=localhost
GRPC_PORT=50051

##############################################
# Harness timeouts — target <25 min wall clock
##############################################

HARNESS_CONTROLLER_LLM_TIMEOUT=300
HARNESS_TURN_TIMEOUT=1800
HARNESS_INACTIVITY_TIMEOUT_MINUTES=20
HARNESS_PROGRESS_TIMEOUT_MINUTES=12
HARNESS_WALL_CLOCK_TIMEOUT_MINUTES=25
HARNESS_REPEATED_FAILURE_THRESHOLD=8
HARNESS_STAGNATION_GRACE_CYCLES=1
HARNESS_MAX_REPAIR_ITERATIONS=3

# Chakra stream idle (ms). Restart Chakra after change.
CLAUDE_STREAM_IDLE_TIMEOUT_MS=180000

ALLOW_AGENT_WORKTREE=1
ENABLE_TOOL_SEARCH=false

# Token → money (edit to match provider invoice rates)
# DATAGEN_PRICE_INPUT_USD_PER_M=0.50
# DATAGEN_PRICE_OUTPUT_USD_PER_M=2.00
# DATAGEN_COMPUTE_UNITS_PER_M=1.0
